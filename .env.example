# Variables de configuración (NO subir este archivo al repo)
# Copia este archivo a ".env" localmente y rellena los valores.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=figuras_ocultas

# --- Host/puerto de MySQL para la app ---
MYSQL_HOST=mysql
MYSQL_PORT=3306

# --- Usuario/contraseña de la BBDD para la app ---
MYSQL_USER=root
MYSQL_PASSWORD=figuras_ocultas_2026_2027

# --- Chatbot (clave de "opencode serve", guardada en /etc/opencode/serve.env) ---
APP_CHATBOT_PASSWORD=pon_aqui_la_clave_de_opencode_serve
# Opcional: URL, modelo y agente (el agente "chatbot" está definido en opencode.json)
#APP_CHATBOT_URL=http://host.docker.internal:4096
#APP_CHATBOT_MODEL=opencode/ling-3.0-flash-fin-free
#APP_CHATBOT_AGENT=chatbot
