# Base de datos existente de la Raspberry
MYSQL_ROOT_PASSWORD=REPLACE_WITH_EXISTING_MYSQL_PASSWORD
MYSQL_DATABASE=figuras_ocultas
MYSQL_BIND_PORT=127.0.0.1:3307

# La API usa esta clave para firmar sesiones; genera una única y larga
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# Tailscale Funnel termina HTTPS delante de Caddy
CORS_ORIGINS=https://raspberryaman.tail055e51.ts.net
