# Base de datos: usa una contraseña larga y única
MYSQL_ROOT_PASSWORD=change-this
MYSQL_DATABASE=figuras_ocultas
# Solo localhost: nunca expongas MySQL a Internet
MYSQL_BIND_PORT=127.0.0.1:3307

# Puerto HTTP local de la aplicación
WEB_PORT=8080

# Clave aleatoria larga para firmar JWT
SECRET_KEY=replace-with-a-long-random-secret

# Dominio público, por ejemplo figuras.tudominio.com
DOMAIN=figuras.example.com
LETSENCRYPT_EMAIL=admin@example.com

# Orígenes permitidos; deja solo tu dominio HTTPS en producción
CORS_ORIGINS=https://figuras.example.com
