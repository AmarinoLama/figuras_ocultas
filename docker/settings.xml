<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <!--
      Redirige TODOS los repositorios (incluidos los antiguos de java.net con
      certificados caducados) hacia Maven Central. Así el "dependency:go-offline"
      (usado para cachear dependencias) no falla por repos HTTP bloqueados o
      certificados expirados.
    -->
    <mirror>
      <id>maven-all-to-central</id>
      <mirrorOf>*</mirrorOf>
      <name>Redirect all repositories to Maven Central</name>
      <url>https://repo.maven.apache.org/maven2</url>
      <blocked>false</blocked>
    </mirror>
  </mirrors>
</settings>